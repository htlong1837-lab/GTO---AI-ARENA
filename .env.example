# Google Gemini API Key (lấy miễn phí tại https://aistudio.google.com/app/apikey)
# Sau khi điền key, mọi máy truy cập vào web đều có thể tạo ảnh AI dùng chung key này.
GEMINI_API_KEY=


# 9router (proxy tương thích OpenAI) — ưu tiên dùng trước Gemini trực tiếp
ROUTER_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=
ROUTER_IMAGE_MODEL=ag/gemini-3.1-flash-image
